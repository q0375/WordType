[Unit]
Description=WordType FastAPI backend
After=network.target

[Service]
Type=simple
User=wordtype
Group=wordtype
WorkingDirectory=/opt/wordtype/backend
Environment=PATH=/opt/wordtype/backend/venv/bin
ExecStart=/opt/wordtype/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
